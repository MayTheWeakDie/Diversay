# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# JWT Authentication
SECRET_KEY=your_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Email / SMTP Settings
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SENDER_EMAIL=your-email@gmail.com

# Service URLs
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8000

# Supabase Credentials
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_key
SUPABASE_SECRET_KEY=your_secret_key
SUPABASE_JWKS_URL=https://your-supabase-project.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_ANON_KEY=your_anon_key

# Gemini AI API Keys
GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Seed Admin Account Credentials
ADMIN1_EMAIL=admin1@example.com
ADMIN1_PASSWORD=your_admin1_password
ADMIN2_EMAIL=admin2@example.com
ADMIN2_PASSWORD=your_admin2_password
